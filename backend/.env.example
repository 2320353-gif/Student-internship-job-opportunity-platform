# Database Configuration
# By default, the application runs on a local SQLite database (internships.db) with 0 setup.
# To connect to Supabase PostgreSQL, uncomment and fill in your connection string:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Port Configuration (defaults to 8000)
PORT=8000
